# Copy to .env for local development and production-build preview.
# Enter actual values only in ignored .env files or your hosting secret settings.
# Required for hourly weather downloads:
NLR_API_KEY=
NLR_EMAIL=
NLR_FULL_NAME=
NLR_AFFILIATION=
# Optional; enables electricity tariff lookup:
OPENEI_API_KEY=
# Optional; enables state commercial natural-gas price lookup:
EIA_API_KEY=
